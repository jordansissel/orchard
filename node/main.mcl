import "os"
import "fmt"
import "strings"
import "iter"
import "golang/strings" as gstr
import "golang"
import "sys"
import "deploy"

import "../systemd/"

$seed_host = "mgmt.local"

# Identify 'model name' line in /proc/cpuinfo
$is_model_name = func($line) { strings.has_prefix($line, "model name") }

# Grab the cpu model name from /proc/cpuinfo
func cpu_info() {
	gstr.trim_prefix(iter.filter(strings.split(os.readfile("/proc/cpuinfo"), "\n"), $is_model_name)[0], "model name\t: ")
}

# Grab the MemTotal value from /proc/meminfo
func mem_info() {
	gstr.trim_prefix(iter.filter(strings.split(os.readfile("/proc/meminfo"), "\n"), func($line) { strings.has_prefix($line, "MemTotal:") })[0], "MemTotal:       ")
}

# Report this node's hardware/asset inventory
class register {
	# smbios type 1 field has a machine uuid... might be useful at some point?
	$uuid = os.readfile("/sys/devices/virtual/dmi/id/product_uuid")
	$cpu = cpu_info()
	$mem = mem_info()

	kv "uuid" {
		mapped => true,
		value => $uuid,
	}

	kv "cpu" {
		mapped => true,
		value => cpu_info(),
	}

	kv "memory" {
		mapped => true,
		value => mem_info(),
		#value => os.system("grep MemTotal /proc/meminfo | sed -re 's/^[^:]+:\\s*//'"),
	}

	# os.release() reports on the os/distro/version
	kv "os" {
		mapped => true,
		value => golang.template("{{ .Id }} {{ .Variant_id }} {{ .Version_id }}", os.release()),
	}

	#kv "uptime" {
	#mapped => true,
	#value => golang.template("{{ . }}", sys.uptime()),
	#}

	#kv "load" {
	#mapped => true,
	#value => golang.template("{{ .X1 }}", sys.load()),
	#}
}

# A nexus is a service that shall run a central mgmt node with etcd.
# This will be the system that leaf nodes seed from
# It will also be the system that 'mgmt deploy lang ....' points at.
#
# This registers 'mgmt.local' in local mDNS for easy discovery
# (see 'nexus-mdns' service below)
class nexus {
	pkg ["avahi"] {
		state => "installed",
	}

	$nexus_script = "/usr/local/bin/nexus-mdns.sh"

	file $nexus_script {
		content => deploy.readfile("/files/nexus-mdns.sh"),
		mode => "u=wrx,g=rx,o=rx",
		state => "exists",
		Notify => Svc["nexus-mdns"],
	}

	include systemd.service("nexus-mdns", struct{
		run => $nexus_script,
	})

	Pkg["avahi"] -> Svc["nexus-mdns"]

	include systemd.service("mgmt", struct{
		run => "mgmt run empty --no-autoedges --server-urls http://0.0.0.0:2380",
	})

	firewalld "mgmt" {
		ports => [ "2380/tcp" ],
		state => "exists",
	}
}

# A regular node will use this class to run mgmt as a service.
class mgmt {
	include systemd.service("mgmt", struct{
		run => "mgmt run empty --seeds http://${seed_host}:2380",
	})
}
