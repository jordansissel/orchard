import "os"
import "fmt"
import "strings"
import "iter"
import "golang/strings" as gstr
import "golang"
import "sys"
import "world"
import "deploy"

import "../systemd/"
import "../access/"
import "../cache/"
import "../nuke/"
import "../hotdesk/"
import "../pkg/"

$seed_host = "mgmt.local"
$distro = os.release()

# Identify 'model name' line in /proc/cpuinfo
$is_model_name = func($line) { strings.has_prefix($line, "model name") }

$is_macos = os.file_exists("/Applications")

# Grab the cpu model name from /proc/cpuinfo
func cpu_info() {
	gstr.trim_prefix(iter.filter(strings.split(os.readfile("/proc/cpuinfo"), "\n"), $is_model_name)[0] <|> "unknown", "model name\t: ")
}

# Grab the MemTotal value from /proc/meminfo
func mem_info() {
	gstr.trim_prefix(iter.filter(strings.split(os.readfile("/proc/meminfo"), "\n"), func($line) { strings.has_prefix($line, "MemTotal:") })[0], "MemTotal:       ")
}

# Report this node's hardware/asset inventory
class register {
	# smbios type 1 field has a machine uuid... might be useful at some point?
	$uuid = strings.trim_space(os.readfile("/sys/devices/virtual/dmi/id/product_uuid") <|> "none")
	$cpu = cpu_info()
	$mem = mem_info()

	schedule "node" {
		max => 1000,
	}

	kv "uuid" {
		mapped => true,
		value => $uuid,
	}

	func dmi($keyword) {
		strings.trim_space(os.readfile("/sys/devices/virtual/dmi/id/${keyword}")) <|> ""
	}

	$serial = dmi("product_serial")
	$name = dmi("product_name")

	if $serial != "" {
		hostname [$serial] {}
		kv "serial" {
			mapped => true,
			value => $serial,
		}

		# the hostname resource doesn't seem to change $hostname 
		# during an mgmt run... so ... a workaround?
		value "hostname" {
			any => $serial,
		}
	} else {
		panic($name == "", "Missing both product serial and product name from dmi table")

		hostname [$name] {}

		# the hostname resource doesn't seem to change $hostname 
		# during an mgmt run... so ... a workaround?
		value "hostname" {
			any => $name,
		}
	}

	if os.file_exists("/etc/machine-id") {
		$machine_id = strings.trim_space(os.readfile("/etc/machine-id"))

		kv "foobar" {
			mapped => true,
			value => "",
		}
		kv "machine-id" {
			mapped => true,
			value => $machine_id,
		}
	} else {
		kv "machine-id" {
			mapped => true,
			value => "none",
		}
	}

	kv "cpu" {
		mapped => true,
		value => cpu_info(),
	}

	kv "memory" {
		mapped => true,
		value => mem_info(),
		#value => os.system("grep MemTotal /proc/meminfo | sed -re 's/^[^:]+:\\s*//'"),
	}

	kv "os" {
		mapped => true,
		value => golang.template("{{ .Id }} {{ .Variant_id }} {{ .Version_id }}", $distro),
	}
}

class monitor {
	include pkg.install(["smartmontools", "pciutils", "lm_sensors"])
}

class basics {
	# Because Fedora Cloud image doesn't ship this by default
	# and it includes the i915 video driver.
	# Install the kernel-modules package specific to the kernel we're running.

	include kernel_modules

	if os.file_exists("/usr/bin/dmidecode") {
		$vendor = strings.trim_space(os.system("dmidecode -s system-manufacturer"))

		if $vendor == "HP" {
			#file "/etc/modules-load.d/hp_bioscfg.conf" {
			#content => "hp_bioscfg\n",
			#state => "exists",
			#}
			#file "/etc/modules-load.d/i915.conf" {
			#content => "i915\n",
			#state => "exists",
			#}
		}
	}
}

class kernel_modules {
	if $distro->id == "debian" {
		# XXX Will this install the correct version?
		# Note: after kernel 6.19~rc4, Debian changed how they package the kernel,
		#       but linux-image-<arch> shouldd still work
		#
		# > This package depends on the corresponding
		# > linux-base-abiname[-featureset]-flavour,
		# > linux-binary-abiname[-featureset]-flavour, and
		# > linux-modules-abiname[-featureset]-flavour packages. Before version
		# > 6.19~rc4-1~exp1 it included all of the same files directly.
		# - https://kernel-team.pages.debian.net/kernel-handbook/ch-packaging.html
		$debarch = strings.trim_space(os.system("dpkg --print-architecture"))
		include pkg.install(["linux-image-${debarch}"])
	}

	if $distro->id == "fedora" {
		$kernel = strings.replace_all(strings.trim_space(os.system("uname -r")), ".x86_64", "")
		include pkg.version("kernel-modules", "${kernel}")
	}
}

# A nexus is a service that shall run a central mgmt node with etcd.
# This will be the system that leaf nodes seed from
# It will also be the system that 'mgmt deploy lang ....' points at.
#
# This registers 'mgmt.local' in local mDNS for easy discovery
# (see 'nexus-mdns' service below)
class nexus {
	schedule "nexus" {
		max => 1,
	}

	if world.schedule("nexus") == [$hostname] {
		include nexus_elected
	}
}

class nexus_elected {
	if not $is_macos {
		include nexus_advertisement
		include access.base
		include nuke.service($address)
	}

	include access.ca

	firewalld "mgmt-http-cache" {
		ports => ["29145/tcp"],
		state => "exists",
	}

	$address = if $is_macos {
		"127.0.0.1:29145"
	} else {
		"0.0.0.0:29145"
	}

	include cache.caching_proxy($address)
}

class nexus_advertisement {
	include pkg.install(["avahi"])

	$nexus_script = "/usr/local/bin/nexus-mdns.sh"

	file $nexus_script {
		content => deploy.readfile("/files/nexus-mdns.sh"),
		mode => "u=wrx,g=rx,o=rx",
		state => "exists",
		Notify => Svc["nexus-mdns"],
	}

	include systemd.service("nexus-mdns", struct{
		run => $nexus_script,
	})

	Pkg["avahi"] -> Svc["nexus-mdns"]

	firewalld "mgmt" {
		ports => ["2379/tcp"],
		state => "exists",
	}

	include mgmt_service
}

# A regular node will use this class to run mgmt as a service.
class mgmt {
	include pkg.install(["avahi", "nss-mdns"])

	include access.base

	if os.is_virtual() {
		# My virtual machines can't (yet) see local subnet multicast, so just hardcode the ip.
		line "mgmt.local in /etc/hosts" {
			content => "10.0.2.2 mgmt.local",
			file => "/etc/hosts",
			state => "exists",
		}
	}

	include mgmt_service
}

class mgmt_service {
	include systemd.service("mgmt", struct{
		run => "mgmt run empty --no-autoedges --seeds http://${seed_host}:2379",
		state => "",
		safe => false,
	})
}

class purpose {
	# If guest, include guest stuff
	$fw_cfg_path = "/sys/firmware/qemu_fw_cfg/by_name/opt/com.oakandspark.hotdesk"

	# hotdesk guests will have this path.
	if os.file_exists($fw_cfg_path) {
		$kind str = os.readfile("${fw_cfg_path}/variant/raw") <|> "default"

		include hotdesk.base
		if $kind != "default" {
			include hotdesk.desktop($kind)
		}
	}

}
