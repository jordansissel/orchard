import "node/"
import "hud/"
import "nuke/"
import "hotdesk/"

import "strings"
import "value"
import "os"

import "moodle.mcl" as moodle

$is_macos = os.file_exists("/Applications")

if $hostname != "eclair.local" {
	include node.register
	include node.monitor
	if $hostname != "coffee.local" {
		include node.basics
	}
}

if $hostname == "coffee.local" or $hostname == "eclair.local" {
	include hud.server
	include node.nexus

	# XXX: Move this somewhere appropriate.
	noop "complete" { }
} else {
	include node.mgmt
	include node.purpose
	include nuke.maybe

	$h = value.get_str("hostname")
	if $h->ready {
		if $h->value == "MXL1342Y3T" {
			#include hotdesk.desktop("kde")
			include hotdesk.desktop("cosmic")
		}
		if $h->value == "moodle" {
			include moodle.moodle
		}
	}
}

print "Hostname" {
	msg => "Hostname: ${hostname}",
}
