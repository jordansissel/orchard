import "node/"
import "hud/"
import "cache/"
import "nuke/"

import "strings"
import "value"
import "os"

$is_macos = os.file_exists("/Applications")

if $hostname != "eclair.local" {
	include node.register
}

if $hostname == "coffee.local" or $hostname == "eclair.local" {
	include hud.server
	include node.nexus

	if $is_macos {
		include cache.caching_proxy("127.0.0.1:29145")
	} else {
		include cache.caching_proxy("0.0.0.0:29145")
	}
} else {
	include node.mgmt

	#if $hostname == "sprite.lan" {
	#include nuke.site
	#}
}
