import "node/"
import "hud/"
import "nuke/"

import "strings"
import "value"
import "os"

$is_macos = os.file_exists("/Applications")

if $hostname != "eclair.local" {
	include node.register
}

print "=========[   GREETINGS     ]======================================" {
	msg => "Hello from ${hostname}",
	Meta:autogroup => false,
}

if $hostname == "coffee.local" or $hostname == "eclair.local" {
	include hud.server
	include node.nexus
} else {
	include node.mgmt

	if $hostname == "pizza.lan" {
		include nuke.site
	}
}
