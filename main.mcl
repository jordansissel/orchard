import "node/"
import "hud/"
import "cache/"
import "nuke/"

import "strings"
import "value"

if $hostname != "eclair.local" {
	include node.register
}

if $hostname == "coffee.local" or $hostname == "eclair.local" {
	include hud.server
	include node.nexus
	include cache.caching_proxy("0.0.0.0:29145")
} else {
	include node.mgmt

	#if $hostname == "sprite.lan" {
	#include nuke.site
