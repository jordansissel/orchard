import "node/"
import "hud/"
import "nuke/"

import "strings"
import "value"
import "os"

import "git://github.com/jordansissel/experiments/mgmt/moodle/"

$is_macos = os.file_exists("/Applications")

if $hostname != "eclair.local" {
	include node.register
	include node.monitor
	if $hostname != "coffee.local" {
		include node.basics
	}
}

if $hostname == "coffee.local" or $hostname == "eclair.local" {
	include hud.server
	include node.nexus
} else {
	include node.mgmt
	include node.purpose

	#if $hostname == "fedora-44-gnome" {
	#include nuke.site
	#}

	if $hostname == "moodle" {
		include moodle.moodle(struct{
			version => "5.2.2",
			#url_template => "http://10.0.2.2:29145/moodle/stable%s/moodle-%s.tgz",
		})
	}
}
