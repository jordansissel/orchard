#!ipxe
#

echo Hello world -- ${buildarch}
sleep 1

set dlhost 192.168.12.86
set arch x86_64

set cmdline console=tty1 console=ttyS0 ip=dhcp rd.neednet=1

echo Command line
echo ${cmdline}

dhcp

echo Booting... with: ${cmdline}
# XXX: Try this again, see what fails. If it fails, uncomment imgfree
# For more details, blame @purpleidea: https://github.com/ipxe/ipxe/issues/1390
#imgfree
shim http://${dlhost}:29145/installer/BOOTX64.efi
initrd http://${dlhost}:29145/installer/initrd
kernel http://${dlhost}:29145/installer/kernel ${cmdline}


boot


