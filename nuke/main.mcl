# Nuke the entire site from orbit.
# It's the only way to be sure.
#
#                   - Ellen Ripley

import "world"
import "deploy"
import "fmt"
import "os"
import "strings"

class site {
	$ca = world.schedule("certificate authority")
	$nexus = world.schedule("nexus")

	if len($nexus) > 0 {
		if $ca == [$hostname] or $nexus == [$hostname] {
			panic("This machine is important! Ignoring attempt to nuke it.")
		} else {
			#$dl = strings.trim_space(os.system("getent hosts mgmt.local | awk '{print $1}'"))
			$dl = "192.168.12.100"

			file "/tmp/x" {
				content => fmt.printf("%v", $nexus),
				state => "exists",
			}

			pkg "avahi-tools" {
				state => "installed",
			}

			#$arch = strings.trim_space(os.system("uname -m"))
			$arch = "x86_64"

			$baseurl = "http://${dl}:29145/fedora/linux/releases/44/Everything/${arch}/os"

			http:client "/tmp/vmlinuz" {
				url => "${baseurl}/images/pxeboot/vmlinuz",
				Meta:retry => 5,
				Meta:delay => 2,
				Meta:poll => -1,
			}

			http:client "/tmp/initrd.img" {
				url => "${baseurl}/images/pxeboot/initrd.img",
				longpoll => false,
				Meta:retry => 5,
				Meta:delay => 2,
				Meta:poll => -1,
			}
				
			$args = "console=tty1 console=ttyS0,115200n8 inst.repo=${baseurl} inst.ks=http://${dl}:29145/installer/fedora.ks"
			exec "kexec" {
				cmd => "kexec",
				args => [ "--initrd", "/tmp/initrd.img", "--append", "\"${args}\"", "/tmp/vmlinuz" ],
				Depend => Http:Client["/tmp/initrd.img"],
				Depend => Http:Client["/tmp/vmlinuz"],
			}
		}
	}
}
