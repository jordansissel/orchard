# Nuke the entire site from orbit.
# It's the only way to be sure.
#
#                   - Ellen Ripley

import "world"
import "deploy"
import "fmt"
import "os"
import "strings"
import "local"
import "sys"
import "../cache/"

class service($http_server) {

	$initrd = local.vardir("nuke/") + "initrd"
	$write = local.vardir("nuke/") + "write-and-reboot.sh"

	file [$write] {
		content => deploy.readfile("/files/write-image-and-reboot.sh"),
		state => "exists",
		Notify => Exec["create initrd for nuking"],
	}

	exec "create initrd for nuking" {
		Depend => File[[$write]],
		creates => fmt.printf("%s", $initrd),
		cmd => "dracut",
		env => {
			"PATH" => sys.getenv("PATH"),
		},
		args => [
			# Make a generic initrd, not specific to this machine.
			"--no-hostonly",

			# With only these dracut modules
			"-m",
			"network systemd-networkd systemd-initrd systemd-emergency dracut-systemd systemd-timesyncd",

			"-a",
			"kernel-modules",

			# And url-lib for curl.
			"-a",
			"url-lib",

			# fat32/vfat filesystem drivers (for mounting EFI partitions)
			"--add-drivers",
			"exfat vfat",

			# Extras for debugging
			"-a",
			"debug terminfo",

			# Bring some tools into the initrd from the host.
			"--install",
			"lsblk xz jq kexec shutdown efibootmgr",

			# Add a script that runs at the end of dracut's pre-pivot.
			# This will run before attempting to mount rootfs and is a good time to burn a disk image.
			"--include",
			$write,
			"/var/lib/dracut/hooks/pre-pivot/99image-disk.sh",

			# Compress the initrd
			"--zstd",

			# Work around nil deref bug.
			fmt.printf("%s", $initrd),
		],
	}

	$kernel = "/boot/vmlinuz-" + os.system("uname -r")

	if os.file_exists($kernel) {
		include cache.file($http_server, "/installer/kernel", $kernel)
		include cache.file($http_server, "/installer/initrd", $initrd)
		include cache.contents($http_server, "/installer/autoexec.ipxe", deploy.readfile("/files/autoexec.ipxe"))
	}

	pkg "ipxe-bootimgs-x86" {
		state => "installed",
	}

	$x86_64 = "/usr/share/ipxe/ipxe-x86_64.efi"
	http:server:file "${http_server} ${x86_64}" {
		server => $http_server,
		filename => "/installer/ipxe-x86_64.efi",
		path => $x86_64,
		Depend => Pkg["ipxe-bootimgs-x86"],
	}

	$shim = "/boot/efi/EFI/BOOT/BOOTX64.efi"
	http:server:file "${http_server} ${shim}" {
		server => $http_server,
		filename => "/installer/BOOTX64.efi",
		path => $shim,
	}

	tftp:server ":69" {
	}

	$tftpshim = "shim.efi"
	tftp:file "/${tftpshim}" {
		path => $shim,
	}

	tftp:file "grubx64.efi" {
		path => $x86_64,
	}

	firewalld "dhcp" {
		ports => ["67/udp"],
		state => "exists",
	}

	firewalld "tftp" {
		ports => ["69/udp", "69/tcp"],
		state => "exists",
	}

	dhcp:server ":67" {
		interface => "wlp0s20f0u7",
		leasetime => "60s",
		dns => [ "192.168.12.1" ],
		routers => [ "192.168.12.1" ],
	}

	#dhcp:host "hp1" {
		#mac => "5c:60:ba:d9:16:25",
		#ip => "192.168.12.50/24",
		#nbp => "tftp://192.168.12.100/${tftpshim}",
	#}

}

class site {
	$ca = world.schedule("certificate authority")
	$nexus = world.schedule("nexus")

	if len($nexus) > 0 {
		if $ca == [$hostname] or $nexus == [$hostname] {
			panic("This machine is important! Ignoring attempt to nuke it.")
		} else {
			#include with_ipxe
			include with_kexec
		}
	}
}

class with_ipxe {
	pkg "jq" {
		state => "installed",
	}

	$remold = local.vardir("reimage-prep/") + "remold-ipxe.sh"
	file [$remold] {
		content => deploy.readfile("/files/remold-ipxe.sh"),
		state => "exists",
		Depend => Pkg["jq"],
	}
}

class with_ipxe_old {
	$ipxe_tmp = local.vardir("nuke-prep/") + "ipxe.efi"
	$dl = "192.168.12.100"

	#http:client [ $ipxe_tmp ] {
	#url => "http://${dl}:29145/installer/ipxe-x86_64.efi",
	#Meta:retry => 5,
	#Meta:delay => 2000,
	#Meta:poll => -1,
	#}
	$ipxe_url = "http://${dl}:29145/installer/ipxe-x86_64.efi"
	$ipxe_path = "/boot/efi/EFI/ipxe.efi"
	exec "curl $ipxe_url" {
		cmd => "curl",
		args => ["--retry", "5", "--retry-delay", "2", "-o", $ipxe_path, $ipxe_url],
		creates => $ipxe_path,
	}

	#file "/boot/efi/EFI/ipxe.efi" {
	#state => "exists",
	#source => $ipxe_tmp,
	#Depend => Http:Client[ $ipxe_tmp ],
	#}

	#http:client "/boot/efi/EFI/autoexec.ipxe" {
	#url => "http://${dl}:29145/installer/autoexec.ipxe",
	#Meta:retry => 5,
	#Meta:delay => 2000,
	#Meta:poll => -1,
	#}

	$autoexec_url = "http://${dl}:29145/installer/autoexec.ipxe"
	$autoexec_path = "/boot/efi/EFI/autoexec.ipxe"
	exec "curl $autoexec_url" {
		cmd => "curl",
		args => ["--retry", "5", "--retry-delay", "2", "-o", $autoexec_path, $autoexec_url],
		creates => $autoexec_path,
		Meta:retry => 5,
		Meta:delay => 2000,
	}

	$jq_efi = "jq -r '.blockdevices[] | select(.children).children[] | select (.mountpoints | contains([\"/boot/efi\"])) | .name'"
	$find_partition = "sed -Ee '/^nvme/{ s/^(.*)p([0-9]+)$/\\1 \\2/; q }; s/^(.*)([0-9]+)$/\\1 \\2/'"
	$efi_disk = strings.split(strings.trim_space(os.system("lsblk --json | ${jq_efi} | ${find_partition}")), " ")

	$dev = $efi_disk[0]
	$partition = $efi_disk[1]
	exec "prepare ipxe for next boot" {
		cmd => "efibootmgr",
		args => ["-c", "-l", "\\EFI\\ipxe.efi", "-L", "orchard nuke", "-d", "/dev/${dev}", "-p", $partition],
		#Depend => File["/boot/efi/EFI/ipxe.efi"],
		Depend => Exec["curl $ipxe_url"],
	}

	exec "set ipxe as next boot" {
		cmd => "sh",
		args => ["-c", "efibootmgr | sed -Ene '/orchard/s/^Boot([0-9A-Fa-f]+).*/\\1/p' | xargs -n1 efibootmgr -n"],
		#Depend => Http:Client["/boot/efi/EFI/autoexec.ipxe"],
		Depend => Exec["curl $autoexec_url"],
		Depend => Exec["prepare ipxe for next boot"],
	}
}

class with_kexec {
	#$dl = strings.trim_space(os.system("getent hosts mgmt.local | awk '{print $1}'"))
	$dl = "192.168.12.100"

	pkg ["avahi-tools", "kexec-tools"] {
		state => "installed",
	}

	#$arch = strings.trim_space(os.system("uname -m"))
	$arch = "x86_64"

	$baseurl = "http://${dl}:29145/fedora/linux/releases/44/Everything/${arch}/os"

	$workdir = local.vardir("nuke-prep/")
	http:client "${workdir}vmlinuz" {
		url => "http://${dl}:29145/installer/kernel",
		Meta:retry => 5,
		Meta:delay => 2000,
		Meta:poll => -1,
	}

	http:client "${workdir}initrd.img" {
		url => "http://${dl}:29145/installer/initrd",
		longpoll => false,
		Meta:retry => 5,
		Meta:delay => 2000,
		Meta:poll => -1,
	}

	#$args = "console=tty1 console=ttyS0,115200n8 inst.repo=${baseurl} inst.ks=http://${dl}:29145/installer/fedora.ks"
