	#Depend => Http:Client["/tmp/initrd.img"],
	#Depend => Http:Client["/tmp/vmlinuz"],
	#}
	#

	#if false {
	$args = "console=tty1 console=ttyS0 ip=dhcp rd.neednet=1"
	exec "kexec" {
		cmd => "kexec",
		args => ["--initrd", fmt.printf("${workdir}initrd.img"), "--append", $args, "${workdir}vmlinuz"],
		Depend => Http:Client["${workdir}initrd.img"],
		Depend => Http:Client["${workdir}vmlinuz"],
		Depend => Pkg["kexec-tools"],
	}
	#}
}
