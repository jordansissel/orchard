import "fmt"
import "sys"
import "golang/os" as g_os
import "strings"
import "os"
import "deploy"

import "../systemd/"

class manager {
	include caching_proxy
	include guest_exports

	include ssh_signer
}

class caching_proxy($address) {
	#$pathname = func($path) []str {
	#["${address} ${path}"]
	#}

	http:server [$address] {}

	$home = g_os.user_home_dir()

	class file($path str, $localpath str) {
		$name = "${address} ${path}"
		http:server:file $name {
			server => $address,
			filename => $path,
			path => $localpath,
		}
	}

	class contents($path str, $contents str) {
		$name = "${address} ${path}"
		http:server:file $name {
			server => $address,
			filename => $path,
			data => $contents,
		}
	}

	class proxy($params) {
		$path = $params->path
		$cache = "${cache_path}/${path}"
		$backend = $params->backend

		# optional
		#$sub = $params->sub <|> ""
		$sub = $params->sub || ""

		$name = "${address} ${path}"
		http:server:proxy $name {
			server => $address,
			cache => $cache,
			path => $path,
			head => $backend,
			sub => $sub,
		}
	}

	include proxy(struct{path => "/mgmt/", backend => "https://github.com/purpleidea/mgmt/releases/download/", sub => "/mgmt/"})
	include file("/hotdesk/guest.mcl", fmt.printf("%s/mcl/guest.mcl", g_os.getwd()))

	include contents("/installer/debian-preseed.txt", deploy.readfile("/files/debian-preseed.txt"))
	include contents("/installer/fedora.ks", deploy.readfile("/files/fedora.ks"))
	include contents("/installer/mgmt.service", systemd.service("mgmt", "mgmt run empty --no-autoedges --seeds http://mgmt.local:2380", struct{}))

	if false {
		exec "create libfake.so" {
			cmd => "make",
			args => ["-C", "/home/jls/projects/hotdesk/fakelib", "all"],
			creates => "/home/jls/projects/hotdesk/fakelib/libfake.so",
		}

		Exec["create libfake.so"] -> Http:Server:File["/fakelib/libfake.so"]

		include file("/fakelib/libfake.so", "/home/jls/projects/hotdesk/fakelib/libfake.so")

		include file("/fakelib/install-fakelib.sh", "/home/jls/projects/hotdesk/fakelib/install-fakelib.sh")
	}

	$cache_path str = fmt.printf("%s/.local/cache/hotdesk/", sys.getenv("HOME"))

	file $cache_path {
		recurse => true, # ~/.local/cache doesn't always exist...
		state => "exists",
	}

	# The odu.edu mirror had an empty repodata directory as of 2026-08-13... Use another for now.
	include proxy(struct{path => "/fedora/", backend => "https://mirror.cs.odu.edu/"})
	#include proxy(struct{path => "/fedora/", backend => "https://mirror-mci.yuki.net.uk/"})
	#include proxy(struct{path => "/fedora/", backend => "https://mirror.pilotfiber.com/"})

	include proxy(struct{path => "/debian/", backend => "http://deb.debian.org/"})

	include proxy(struct{path => "/debian-archive/debian/", backend => "http://archive.debian.org/", sub => "/debian-archive/"})

	include proxy(struct{path => "/debian-security/", backend => "http://security.debian.org/"})

	include proxy(struct{path => "/ubuntu-ports/", backend => "http://ports.ubuntu.com/"})

	include proxy(struct{path => "/ubuntu/", backend => "http://archive.ubuntu.com/"})

	include proxy(struct{path => "/archlinux/", backend => "https://fastly.mirror.pkgbuild.com/", sub => "/archlinux/"})
}

class hotdesk($name str, $config struct{distro str; release str; option str}) {
	exec "hotdesk ${name}" {
		cmd => "target/debug/hotdesk",
		args => ["prepare", $name, $config->distro, $config->release, $config->option],
		env => {"HOME" => sys.getenv("HOME")},
		nifcmd => "target/debug/hotdesk is-prepared $name",
		Meta:sema => ["hotdesk:1"],
	}
}

class guest_exports {
	file "/usr/local/bin/mount-workdir.sh" {
		content => os.readfile(fmt.printf("%s/mcl/mount-workdir.sh", g_os.getwd())),
		state => "exists",
		mode => "0755",

		Meta:export => ["*"],
		Meta:hidden => true,
	}

	file "/etc/systemd/system/mount-workdir.service" {
		content => os.readfile(fmt.printf("%s/mcl/mount-workdir.service", g_os.getwd())),
		state => "exists",
		mode => "0644",

		Meta:export => ["*"],
		Meta:hidden => true,
	}

	file "/etc/systemd/system/mgmt.service" {
		content => os.readfile(fmt.printf("%s/mcl/mgmt.service", g_os.getwd())),
		state => "exists",
		mode => "0644",

		Meta:export => ["*"],
		Meta:hidden => true,
	}

	svc "mount-workdir" {
		startup => "enabled",
		Meta:export => ["*"],
		Meta:hidden => true,
	}

	svc "mgmt" {
		startup => "enabled",
		Meta:export => ["*"],
		Meta:hidden => true,
	}
}

