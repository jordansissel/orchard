import "fmt"
import "sys"
import "golang/os" as g_os
import "strings"
import "os"
import "deploy"
import "convert"
import "local"
import "golang"

import "../systemd/"

$is_macos = os.file_exists("/Applications")

class file($address str, $path str, $localpath str) {
	$name = "${address} ${path}"
	http:server:file $name {
		server => $address,
		filename => $path,
		path => $localpath,
	}
}

class contents($address str, $path str, $contents str) {
	$name = "${address} ${path}"

	# local.pool rejects if the 2nd arg has a slash??
	$id = convert.int_to_str(local.pool("http cache", strings.replace_all($path, "/", "_")))

	$local = local.vardir("cache-file/") + $id

	file [ $local ] {
		content => $contents,
		state => "exists",
	}

	include file($address, $path, $local)
}

class caching_proxy($address) {
	http:server [$address] {}

	$home = g_os.user_home_dir()

	class proxy($params) {
		$path = $params->path
		$cache = "${cache_path}/${path}"
		$backend = $params->backend

		# optional
		#$sub = $params->sub <|> ""
		$sub = $params->sub <|> ""

		$name = "${address} ${path}"
		http:server:proxy $name {
			server => $address,
			cache => $cache,
			path => $path,
			head => $backend,
			sub => $sub,
		}
	}

	if $is_macos {
		include file($address, "/mgmt/latest", os.expand_home("~/projects/mgmt/build/mgmt-linux-arm64"))
		include file($address, "/mgmt/current", os.expand_home("~/projects/mgmt/build/mgmt-linux-arm64"))
	} else {
		include file($address, "/mgmt/current", deploy.binary_path())
	}

	include file($address, "/hotdesk/guest.mcl", fmt.printf("%s/mcl/guest.mcl", g_os.getwd()))

	# XXX: Move these into some separate provisioner class?
	include contents($address, "/installer/debian-preseed.txt", deploy.readfile("/files/debian-preseed.txt"))

	$seed_host = "mgmt.local"
	$seed_ip str = strings.split(os.system("avahi-resolve -n ${seed_host}"), "\t")[1]

	include contents($address, "/installer/fedora.ks", golang.template( deploy.readfile("/files/fedora.ks"), struct { host => $seed_ip }))
	include contents($address, "/installer/cloud-init/meta-data", "")

	# cloud-init checks and waits for these files, so it's faster to just serve empty files.
	include contents($address, "/installer/cloud-init/vendor-data", "")
	include contents($address, "/installer/cloud-init/network-config", "")

	include contents($address, "/installer/cloud-init/user-data", deploy.readfile("/files/cloud-init/user-data"))
	include contents($address, "/installer/mgmt.service", systemd.service("mgmt", "mgmt run empty --no-autoedges --seeds http://mgmt.local:2380", struct{}))

	$cache_path str = fmt.printf("%s/.local/cache/hotdesk/", sys.getenv("HOME"))

	file $cache_path {
		recurse => true, # ~/.local/cache doesn't always exist...
		state => "exists",
	}

	# The odu.edu mirror had an empty repodata directory as of 2026-08-13... Use another for now.
	include proxy(struct{path => "/fedora/", backend => "https://mirror.cs.odu.edu/"})
	#include proxy(struct{path => "/fedora/", backend => "https://mirror-mci.yuki.net.uk/"})
	#include proxy(struct{path => "/fedora/", backend => "https://mirror.pilotfiber.com/"})

	include proxy(struct{path => "/debian/", backend => "http://deb.debian.org/"})

	include proxy(struct{path => "/debian-archive/debian/", backend => "http://archive.debian.org/", sub => "/debian-archive/"})

	include proxy(struct{path => "/debian-security/", backend => "http://security.debian.org/"})

	include proxy(struct{path => "/ubuntu-ports/", backend => "http://ports.ubuntu.com/"})

	include proxy(struct{path => "/ubuntu/", backend => "http://archive.ubuntu.com/"})

	include proxy(struct{path => "/archlinux/", backend => "https://fastly.mirror.pkgbuild.com/", sub => "/archlinux/"})
}

class hotdesk($name str, $config struct{distro str; release str; option str}) {
	exec "hotdesk ${name}" {
		cmd => "target/debug/hotdesk",
		args => ["prepare", $name, $config->distro, $config->release, $config->option],
		env => {"HOME" => sys.getenv("HOME")},
		nifcmd => "target/debug/hotdesk is-prepared $name",
		Meta:sema => ["hotdesk:1"],
	}
}

class guest_exports {
	file "/usr/local/bin/mount-workdir.sh" {
		content => os.readfile(fmt.printf("%s/mcl/mount-workdir.sh", g_os.getwd())),
		state => "exists",
		mode => "0755",

		Meta:export => ["*"],
		Meta:hidden => true,
	}

	file "/etc/systemd/system/mount-workdir.service" {
		content => os.readfile(fmt.printf("%s/mcl/mount-workdir.service", g_os.getwd())),
		state => "exists",
		mode => "0644",

		Meta:export => ["*"],
		Meta:hidden => true,
	}

	file "/etc/systemd/system/mgmt.service" {
		content => os.readfile(fmt.printf("%s/mcl/mgmt.service", g_os.getwd())),
		state => "exists",
		mode => "0644",

		Meta:export => ["*"],
		Meta:hidden => true,
	}

	svc "mount-workdir" {
		startup => "enabled",
		Meta:export => ["*"],
		Meta:hidden => true,
	}

	svc "mgmt" {
		startup => "enabled",
		Meta:export => ["*"],
		Meta:hidden => true,
	}
}

